---
import Base from '../layouts/Base.astro';
---
<Base title="Certyfikaty i szkolenia" active="certs" description="Rejestr certyfikatów, szkoleń i wykształcenia — Jan Mejor, analityk biznesowy.">
  <section class="certs-hero">
    <div class="wrap">
      <h1>Certyfikaty i szkolenia</h1>
      <p>Pełny rejestr ukończonych certyfikacji, szkoleń zawodowych i wykształcenia formalnego.</p>
    </div>
  </section>
  <section>
    <div class="wrap">

      <div class="reg-group">
        <h3>CERTYFIKATY ZAWODOWE</h3>
        <table class="reg">
          <tr><td class="name">AIDEAS Level UP — część zespołowa (Ethical AI Hacker)</td><td class="issuer">Generator Pomysłów / Accenture / Uniwersytet Łódzki</td><td class="year">2026</td></tr>
          <tr><td class="name">Microsoft AI dla Programistów</td><td class="issuer">Microsoft</td><td class="year">—</td></tr>
          <tr><td class="name">Power Automate</td><td class="issuer">Microsoft</td><td class="year">—</td></tr>
          <tr><td class="name">ISTQB — Tester Poziom Podstawowy</td><td class="issuer">ISTQB</td><td class="year">—</td></tr>
          <tr><td class="name">Praktyka stosowania zamówień publicznych na dostawy i usługi informatyczne po nowelizacji 2016</td><td class="issuer">—</td><td class="year">2016</td></tr>
        </table>
      </div>

      <div class="reg-group">
        <h3>SZKOLENIA I WARSZTATY</h3>
        <table class="reg">
          <tr><td class="name">Akademia Trenera Biznesu — poziom zaawansowany</td><td class="issuer">MARR, Małopolska Agencja Rozwoju Regionalnego</td><td class="year">2010</td></tr>
          <tr><td class="name">Format MARC 21 opisu bibliograficznego i zasady katalogowania</td><td class="issuer">Biblioteka Narodowa</td><td class="year">2010</td></tr>
          <tr><td class="name">Wprowadzenie do e-learningu</td><td class="issuer">Akademia NASK</td><td class="year">2011</td></tr>
          <tr><td class="name">Intensive Course on XML</td><td class="issuer">Saxion University of Professional Education</td><td class="year">2005</td></tr>
        </table>
      </div>

      <div class="reg-group">
        <h3>KURSY JĘZYKOWE</h3>
        <table class="reg">
          <tr><td class="name">Język angielski — poziom upper-intermediate</td><td class="issuer">Profi-Lingua, ośrodek egzaminacyjny TELC</td><td class="year">2006</td></tr>
        </table>
      </div>

      <div class="reg-group">
        <h3>WYKSZTAŁCENIE FORMALNE</h3>
        <table class="reg">
          <tr><td class="name">Magister — informacja naukowa i bibliotekoznawstwo</td><td class="issuer">Uniwersytet Warszawski, Wydział Historyczny</td><td class="year">2011</td></tr>
        </table>
      </div>

    </div>
  </section>
</Base>
