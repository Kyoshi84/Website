---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import BlogFilters from '../../components/BlogFilters.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = (await getPublishedPosts()).filter((p) => p.data.category === 'artykul');
---
<Base title="Artykuły" active="blog" description="Artykuły o analizie biznesowej, procesach i wdrożeniach IT.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Artykuły</h1>
      <p>Teksty o analizie wymagań, procesach biznesowych i wdrożeniach IT.</p>
      <BlogFilters current="artykul" />
    </div>
  </section>
  <section>
    <div class="wrap">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
