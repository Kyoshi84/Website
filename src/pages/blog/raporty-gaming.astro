---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import BlogFilters from '../../components/BlogFilters.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = (await getPublishedPosts()).filter((p) => p.data.category === 'raport-gaming');
---
<Base title="Raporty Gaming" active="blog" description="Cykliczne raporty z rynku gier: iGaming, zakłady sportowe, loterie państwowe, regulacje i dostawcy technologii.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Raporty Gaming</h1>
      <p>Dwa razy w tygodniu: iGaming, zakłady sportowe i loterie państwowe w Polsce i na świecie. Regulacje, przetargi, technologie i wydarzenia branżowe.</p>
      <BlogFilters current="raport-gaming" />
    </div>
  </section>
  <section>
    <div class="wrap">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
