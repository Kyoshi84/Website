---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import BlogFilters from '../../components/BlogFilters.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = (await getPublishedPosts()).filter((p) => p.data.category === 'raport-ai');
---
<Base title="Raporty AI" active="blog" description="Cykliczne raporty z rynku AI: modele, polski rynek, Bielik AI, regulacje i konferencje.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Raporty AI</h1>
      <p>Dwa razy w tygodniu: najważniejsze wiadomości o modelach AI, polskim rynku, Bieliku, regulacjach i nadchodzących konferencjach. Terminy konferencji AI zbieram w <a href="/konferencje/ai/">kalendarzu konferencji</a>.</p>
      <BlogFilters current="raport-ai" />
    </div>
  </section>
  <section>
    <div class="wrap">
      <PostList posts={posts} />
    </div>
  </section>
</Base>
