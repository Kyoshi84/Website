---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORY_LABEL, formatDate, getPublishedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---
<Base
  title={post.data.title}
  description={post.data.description}
  active="blog"
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  section={CATEGORY_LABEL[post.data.category]}
>
  <article>
    <header class="post-head">
      <div class="wrap">
        <a class="back" href="/blog/">← Wszystkie wpisy</a>
        <div class="post-meta" style="margin-top:22px">
          <span class:list={['badge', { alt: post.data.category === 'artykul', gaming: post.data.category === 'raport-gaming' }]}>{CATEGORY_LABEL[post.data.category]}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </div>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </div>
    </header>
    <div class="wrap">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
